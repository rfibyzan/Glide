<Project Sdk="Microsoft.NET.Sdk">

  <!-- The index service, linked into glide.exe: one executable runs either the
       launcher or, started by the SCM with the service flag, the indexer. Only the
       service process reads the USN journal; the launcher never loads it. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Glide.Service</RootNamespace>
    <AssemblyName>Glide.Service</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Glide.Core\Glide.Core.csproj" />
  </ItemGroup>

</Project>
